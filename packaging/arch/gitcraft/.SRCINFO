pkgbase = gitcraft
	pkgdesc = A small, personal visual git client
	pkgver = 0.3.5
	pkgrel = 1
	url = https://github.com/JKamsker/gitcraft
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	makedepends = pkgconf
	depends = git
	depends = gcc-libs
	depends = glibc
	depends = alsa-lib
	depends = libxkbcommon
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	depends = wayland
	optdepends = vulkan-driver: Vulkan graphics backend
	optdepends = mesa: OpenGL graphics backend
	optdepends = org.freedesktop.secrets: save connection credentials
	optdepends = xdg-desktop-portal: native file dialogs
	optdepends = xdg-utils: open links in the default browser
	optdepends = git-lfs: Git LFS support
	conflicts = gitcraft-bin
	options = !lto
	source = git+https://github.com/JKamsker/gitcraft.git#commit=3df3711bdf7059ca456f68138a859d31daedd1ca
	sha256sums = SKIP

pkgname = gitcraft
