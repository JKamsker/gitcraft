[Desktop Entry]
Type=Application
Name=gitcraft
Comment=A small visual git client
Exec=gitcraft %f
Terminal=false
Categories=Development;RevisionControl;
Icon=gitcraft
StartupWMClass=gitcraft
Actions=clone;open;quit;

[Desktop Action clone]
Name=Clone…
Exec=gitcraft --clone

[Desktop Action open]
Name=Open…
Exec=gitcraft --open

[Desktop Action quit]
Name=Quit gitcraft
Exec=gitcraft --quit
