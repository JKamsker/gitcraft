dev-baseline-toggle = { $label } · { $state }

dev-baseline-on = Ein

dev-baseline-off = Aus

dev-baseline-settings-label-0 = Optionale Werkzeuge

dev-baseline-settings-label-1 = Verlauf / Diagnose

dev-baseline-settings-label-2 = Commits aufteilen und verschieben

dev-baseline-settings-label-3 = Branch-Probelauf

dev-baseline-settings-label-4 = Seitenleiste

dev-baseline-settings-label-5 = Agentenbereich anzeigen

dev-baseline-optional-tip = Häufige Branch- und Commit-Aktionen bleiben griffbereit. Hier ausgeblendete optionale Werkzeuge sind weiter über die Befehlspalette erreichbar; wähle zuerst den gewünschten Commit.

dev-baseline-optional-0 = Bisect und Commit-Tests anzeigen

dev-baseline-optional-1 = Aufteilen und Verschieben anzeigen

dev-baseline-optional-2 = Probeläufe und Interaktionswerkzeuge anzeigen

dev-baseline-optional-3 = Release erstellen anzeigen

dev-baseline-agents-tip = Die Sichtbarkeit von Aufgaben ändert weder Agentenrechte noch hält sie laufende Aufgaben an.

dev-baseline-agents-show = Agentenbereich anzeigen

dev-baseline-preview = Vorschau

dev-baseline-replay-message = Die erneut angewendeten Commits behalten ihre eigenen Nachrichten

dev-baseline-filter-0 = T3-Code-Zwischenstände ausblenden

dev-baseline-filter-1 = Exakter Autorenname T3 Code und E-Mail t3code@users.noreply.github.com. Mitautoren-Abzeichen blenden niemals Commits aus.

dev-baseline-filter-2 = Ausgeschlossene Autorennamen

dev-baseline-filter-3 = Exakte Namen, einer pro Zeile; Groß-/Kleinschreibung beachten

dev-baseline-filter-4 = Ausgeschlossene Autoren-E-Mails

dev-baseline-filter-5 = Exakte E-Mail-Adressen, eine pro Zeile; Groß-/Kleinschreibung ignorieren

dev-baseline-filter-6 = Ausgeblendete Referenznamensräume

dev-baseline-filter-7 = Vollständige refs/-Muster, eines pro Zeile (z. B. refs/t3/*)

dev-baseline-filter-8 = Nur die Anzeige ändert sich. Spitzen, Auswahl, Suchziele und Seitengrenzen bleiben erreichbar.

dev-baseline-filter-9 = Verlaufsfilter

dev-baseline-filter-10 = Globale Verlaufsfilter ersetzen

dev-baseline-filter-11 = Aus: Diese Regeln zu Einstellungen → Commit-Graph hinzufügen. Ein: Nur diese Regeln verwenden.

dev-baseline-filter-12 = Repository-Filter zurücksetzen

dev-baseline-filter-13 = Ausgeblendete anzeigen

dev-baseline-filter-14 = Ausgeschlossene Autoren und Referenznamensräume in diesem Repository vorübergehend anzeigen. Git-Daten bleiben unverändert.

dev-baseline-filter-invalid = Ungültige Referenzmuster ignoriert: { $patterns }

dev-baseline-filter-hidden = { $count } Autorenzeilen im geladenen Verlauf ausgeblendet

dev-baseline-filter-namespace = { $count } Commits nur über ausgeschlossene Namensräume erreichbar

dev-baseline-filter-kept = { $count } passende Commits beibehalten: Spitzen, Auswahl, Suche oder Seitengrenzen

dev-baseline-filter-summary = { $authors } Autorenzeilen im geladenen Verlauf ausgeblendet; { $namespaces } nur über Namensräume erreichbare Commits ausgeschlossen. Öffnen, um globale Ergänzungen oder Repository-Regeln zu bearbeiten.

dev-baseline-selection-release = Release bei { $commit } erstellen…

dev-baseline-selection-split = Commit { $commit } aufteilen…

dev-baseline-selection-move = Änderungen aus { $commit } verschieben…

dev-baseline-selection-bisect = Bisect bei { $commit } starten…

dev-baseline-selection-parallel-bisect = Paralleles Bisect ab { $commit }…

dev-baseline-selection-test = Commits bis { $commit } testen…

dev-baseline-guard-0 = Die primäre Remote wurde geändert oder entfernt; plane die Fork-Aktion erneut

dev-baseline-guard-1 = Die tatsächlich verwendete Fetch-URL der primären Remote hat sich geändert; plane die Fork-Aktion erneut

dev-baseline-guard-2 = Die Fork-Remote des Mitwirkenden wurde entfernt; plane die Aktion erneut

dev-baseline-guard-3 = Die Fork-Remote des Mitwirkenden wurde geändert; plane die Aktion erneut

dev-baseline-guard-4 = Die primäre Forge wurde geändert; plane diese Fork-Aktion erneut. Abgeschlossene lokale Umschreibungen bleiben rückgängig machbar.

dev-baseline-guard-5 = Unbekannte Forge im gespeicherten Checkout

dev-baseline-guard-6 = Dieser gespeicherte Fork-Checkout enthält kein festgehaltenes Ziel; checke den Pull Request erneut aus

dev-baseline-guard-7 = Der gespeicherte Fork-Checkout enthält kein ursprüngliches tatsächliches Ziel; checke den Pull Request erneut aus

dev-baseline-guard-8 = Die gespeicherte Fork-Remote fehlt; checke den Pull Request erneut aus

dev-baseline-guard-9 = Das gespeicherte Fork-Ziel hat sich geändert; checke den Pull Request erneut aus

dev-baseline-guard-10 = Push-Ziel für den Fork fehlt

dev-baseline-guard-11 = Ein Fork-Push benötigt einen ausdrücklich festgelegten erwarteten Commit

dev-baseline-guard-12 = Für den Fork-Push wurde kein erwarteter Commit festgehalten; plane die Aktion erneut

dev-baseline-guard-13 = Der neu aufgebaute Branch wurde vor dem Push geändert; plane die Aktion erneut

dev-baseline-guard-14 = Refspec für den Fork-Push fehlt

dev-baseline-guard-15 = Dieses Issue gehört zu einer anderen primären Forge; wähle es erneut aus

dev-baseline-guard-16 = Dieses Issue gehört zu einem anderen Forge-Repository; öffne seine gespeicherte URL

dev-baseline-guard-17 = Keine primäre Forge ausgewählt

dev-baseline-guard-18 = Die primäre Forge-Remote ist nicht verfügbar; aktualisiere vor dem Öffnen dieses Pull Requests

dev-baseline-guard-19 = Zum Veröffentlichen wird das Push-Ziel des Releases benötigt

dev-baseline-guard-20 = Die primäre Forge wurde während dieses Releases geändert; die Veröffentlichung wurde gestoppt. Lokale Änderungen bleiben rückgängig machbar. Schließe dieses Release, bevor du eines auf der neuen Forge beginnst.

dev-baseline-guard-21 = Der Vorgang auf der vorherigen primären Forge wurde beendet; aktualisiere dieses Repository, um das Ergebnis zu prüfen

dev-baseline-guard-22 = Die Push-Lease muss genau diese Referenz benennen.

dev-baseline-guard-23 = Die Push-Lease muss genau diese Referenz und dieses Objekt benennen.

dev-baseline-guard-24 = Der Push enthält widersprüchliche explizite Leases; öffne die ursprüngliche Aktion erneut.

dev-baseline-guard-25 = Das abgerufene Ziel weicht von der erfassten Push-Lease ab; öffne die ursprüngliche Aktion erneut.

dev-baseline-guard-26 = Die erfasste Push-Lease wurde geändert; öffne die ursprüngliche Aktion erneut.

dev-baseline-guard-27 = Die geprüfte Fork-Quelle wurde geändert; öffne die Push-Vorabprüfung erneut

dev-baseline-fold-staged-label = Vorgemerkte Änderungen in einen älteren Commit einarbeiten
