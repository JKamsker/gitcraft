# Package and updater display partition. Resolve at paint time; external details stay opaque.
interaction-package-note-environment = eine Umgebungsdatei: enthält oft Geheimnisse
interaction-package-note-credentials = eine Zugangsdaten-Datei: enthält möglicherweise ein Token
interaction-package-note-key = ein Schlüssel oder Zertifikat
interaction-package-note-build = Build-Ausgaben oder Abhängigkeiten
interaction-package-note-leftover = Überreste eines Editors oder Werkzeugs
interaction-package-note-log = eine Protokolldatei
interaction-package-note-archive = ein Archiv, möglicherweise ein früheres Paket
interaction-package-note-database = eine Datenbank
interaction-package-note-untracked = Git verfolgt die Datei nicht: ein Überrest in diesem Ordner
interaction-package-note-readme = die README: wird auf der Seite der Registry angezeigt
interaction-package-note-licence = die Lizenz: die meisten Lizenzen müssen mit dem Code ausgeliefert werden
interaction-package-note-source = eine Quelldatei: ohne sie lässt sich das Paket möglicherweise nicht bauen
interaction-package-note-manifest = { $manifest } verweist darauf ({ $key })
interaction-package-note-big = groß für ein Paket ({ NUMBER($size, minimumFractionDigits: 1, maximumFractionDigits: 1) } { $unit })
interaction-package-hint = package.json enthält ein { $script }-Skript, das npm publish vorher ausführt, diese Auflistung jedoch nicht: dadurch erzeugte Dateien können als ausgelassen oder entfernt erscheinen, bis das Skript ausgeführt wurde
interaction-package-tool-missing = { $program } wurde am Speicherort des Repositorys nicht gefunden (nicht installiert oder nicht im PATH): dieses Werkzeug listet die Dateien des Pakets auf
interaction-package-tool-run = { $program } konnte nicht ausgeführt werden: { $detail }
interaction-package-tool-timeout = { $program } benötigte länger als { $minutes } Minuten (wartet es auf eine Sperre oder das Netzwerk?): gestoppt
interaction-package-tool-failed = { $program } ist fehlgeschlagen
interaction-package-cargo-error = cargo: { $detail }
interaction-package-no-manifest = Keine Cargo.toml oder package.json im Stammverzeichnis des Repositorys
interaction-package-cargo-metadata = cargo metadata: { $detail }
interaction-package-npm-no-package = npm hat kein Paket gemeldet
interaction-package-npm-answer = Antwort von npm pack: { $detail }
interaction-package-other-registry = Auf { $registry } statt auf { $expected } veröffentlicht: kein Vergleich
interaction-package-registry-json = { $url } hat nicht mit JSON geantwortet: { $detail }
interaction-package-ask-registry = { $url } konnte nicht abgefragt werden: { $detail }
interaction-package-download = { $url } konnte nicht heruntergeladen werden: { $detail }
interaction-package-archive-too-big = das Archiv ist größer als { NUMBER($size, minimumFractionDigits: 1, maximumFractionDigits: 1) } { $unit }: kein Vergleich
interaction-package-archive-gzip = kein gzip-komprimiertes Archiv: { $detail }
interaction-package-archive-damaged = ein beschädigtes Archiv
interaction-package-errors = { $cargo }; package.json: { $detail }
interaction-package-json-error = package.json: { $detail }
interaction-update-channel-main = Main (Veröffentlichungen)
interaction-update-channel-dev = Dev (ein Build für jede Änderung)
interaction-update-previous-kept = die aufbewahrte Version
interaction-update-download-too-big = größer als erwartet
interaction-update-copy-new = Die neue Version konnte nicht kopiert werden
interaction-update-not-updated = Diese Kopie von gitcraft wird nicht aktualisiert
interaction-update-no-build = Die Veröffentlichungen enthalten keinen Build für dieses System
interaction-update-no-download-folder = Kein Ordner zum Herunterladen des Updates vorhanden
interaction-update-asset-missing = { $asset } enthält kein gitcraft
interaction-update-download = { $url } konnte nicht heruntergeladen werden: { $detail }
interaction-update-unpack = Das Update konnte nicht entpackt werden: { $detail }
interaction-update-no-previous = Es wurde keine vorherige Version von gitcraft aufbewahrt
interaction-update-move-aside = { $target } konnte nicht beiseite verschoben werden: { $detail }
interaction-update-put-new = Die neue Version konnte nicht an ihren Platz verschoben werden: { $detail }
interaction-update-restore = gitcraft { $previous } konnte nicht wiederhergestellt werden: { $detail }
interaction-update-restore-both = Weder gitcraft { $previous } ({ $detail }) noch diese Version konnte wiederhergestellt werden: sie liegt unter { $old }; benenne sie manuell wieder in { $target } um
