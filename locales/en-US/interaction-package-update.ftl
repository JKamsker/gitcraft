# Package and updater display partition. Resolve at paint time; external details stay opaque.
interaction-package-note-environment = an environment file: often secrets
interaction-package-note-credentials = a credentials file: may hold a token
interaction-package-note-key = a key or certificate
interaction-package-note-build = build output or dependencies
interaction-package-note-leftover = an editor's or tool's leftover
interaction-package-note-log = a log
interaction-package-note-archive = an archive, perhaps an earlier package
interaction-package-note-database = a database
interaction-package-note-untracked = git doesn't track it: a leftover of this folder
interaction-package-note-readme = the README: the registry's page shows it
interaction-package-note-licence = the licence: most licences ask to be shipped with the code
interaction-package-note-source = a source file: the package may not build without it
interaction-package-note-manifest = { $manifest } names it ({ $key })
interaction-package-note-big = big for a package ({ NUMBER($size, minimumFractionDigits: 1, maximumFractionDigits: 1) } { $unit })
interaction-package-hint = package.json has a { $script } script, which npm publish runs first and this listing doesn't: files it builds may show as left out or gone until it has run
interaction-package-tool-missing = { $program } wasn't found where the repository is (not installed, or not on its PATH): it is what lists the package's files
interaction-package-tool-run = Couldn't run { $program }: { $detail }
interaction-package-tool-timeout = { $program } took longer than { $minutes } minutes (waiting for a lock, or the network?): stopped
interaction-package-tool-failed = { $program } failed
interaction-package-cargo-error = cargo: { $detail }
interaction-package-no-manifest = No Cargo.toml or package.json at the top of the repository
interaction-package-cargo-metadata = cargo metadata: { $detail }
interaction-package-npm-no-package = npm said no package
interaction-package-npm-answer = npm pack's answer: { $detail }
interaction-package-other-registry = published to { $registry }, not { $expected }: not compared
interaction-package-registry-json = { $url } didn't answer with JSON: { $detail }
interaction-package-ask-registry = couldn't ask { $url }: { $detail }
interaction-package-download = couldn't download { $url }: { $detail }
interaction-package-archive-too-big = the archive is bigger than { NUMBER($size, minimumFractionDigits: 1, maximumFractionDigits: 1) } { $unit }: not compared
interaction-package-archive-gzip = not a gzip'd archive: { $detail }
interaction-package-archive-damaged = a damaged archive
interaction-package-errors = { $cargo }; package.json: { $detail }
interaction-package-json-error = package.json: { $detail }
interaction-update-channel-main = Main (releases)
interaction-update-channel-dev = Dev (a build of every change)
interaction-update-previous-kept = the version kept
interaction-update-download-too-big = bigger than expected
interaction-update-copy-new = Could not copy the new version
interaction-update-not-updated = This copy of gitcraft isn't updated
interaction-update-no-build = The releases have no build for this system
interaction-update-no-download-folder = No folder to download the update into
interaction-update-asset-missing = { $asset } holds no gitcraft
interaction-update-download = Could not download { $url }: { $detail }
interaction-update-unpack = Could not unpack the update: { $detail }
interaction-update-no-previous = No previous version of gitcraft is kept
interaction-update-move-aside = Could not move { $target } aside: { $detail }
interaction-update-put-new = Could not put the new version in place: { $detail }
interaction-update-restore = Could not put gitcraft { $previous } back in place: { $detail }
interaction-update-restore-both = Could not put gitcraft { $previous } back in place ({ $detail }), nor this version: it is at { $old }; rename it back to { $target } by hand
