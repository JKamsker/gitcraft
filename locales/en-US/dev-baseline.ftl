dev-baseline-toggle = { $label } · { $state }

dev-baseline-on = On

dev-baseline-off = Off

dev-baseline-settings-label-0 = Optional tools

dev-baseline-settings-label-1 = History / diagnostics

dev-baseline-settings-label-2 = Commit surgery

dev-baseline-settings-label-3 = Branch rehearsal

dev-baseline-settings-label-4 = Sidebar

dev-baseline-settings-label-5 = Show Agents section

dev-baseline-optional-tip = Keep common branch and commit actions close at hand. Optional tools stay available in the command palette when hidden here; select a commit first to act on it.

dev-baseline-optional-0 = Show bisect and commit tests

dev-baseline-optional-1 = Show split and move changes

dev-baseline-optional-2 = Show rehearsal and interaction tools

dev-baseline-optional-3 = Show Cut release

dev-baseline-agents-tip = Task visibility does not change agent permissions or stop running tasks.

dev-baseline-agents-show = Show Agents section

dev-baseline-preview = Preview

dev-baseline-replay-message = The commits being replayed keep their own messages

dev-baseline-filter-0 = Hide T3 Code checkpoint identity

dev-baseline-filter-1 = Exact author name T3 Code and email t3code@users.noreply.github.com. Co-writer badges never hide commits.

dev-baseline-filter-2 = Excluded author names

dev-baseline-filter-3 = Exact names, one per line; case-sensitive

dev-baseline-filter-4 = Excluded author emails

dev-baseline-filter-5 = Exact emails, one per line; case-insensitive

dev-baseline-filter-6 = Hidden ref namespaces

dev-baseline-filter-7 = Full refs/ patterns, one per line (e.g. refs/t3/*)

dev-baseline-filter-8 = Display only. Tips, selection, search targets and page boundaries remain accessible.

dev-baseline-filter-9 = History filters

dev-baseline-filter-10 = Override global history filters

dev-baseline-filter-11 = Off: add these rules to Settings → Commit graph. On: use only these rules.

dev-baseline-filter-12 = Reset repository filters

dev-baseline-filter-13 = Show hidden

dev-baseline-filter-14 = Temporarily reveal excluded authors and ref namespaces in this repository. No Git data is changed.

dev-baseline-filter-invalid = Ignored invalid ref patterns: { $patterns }

dev-baseline-filter-hidden = { $count } author rows hidden in loaded history

dev-baseline-filter-namespace = { $count } commits reachable only from excluded namespaces

dev-baseline-filter-kept = { $count } matching commits kept: tips, selection, search or page boundaries

dev-baseline-filter-summary = { $authors } author rows hidden in loaded history; { $namespaces } namespace-only commits excluded. Open to edit global additions or repository overrides.

dev-baseline-selection-release = Cut release at { $commit }…

dev-baseline-selection-split = Split commit { $commit }…

dev-baseline-selection-move = Move changes from { $commit }…

dev-baseline-selection-bisect = Start bisect at { $commit }…

dev-baseline-selection-parallel-bisect = Bisect in parallel from { $commit }…

dev-baseline-selection-test = Test commits up to { $commit }…

dev-baseline-guard-0 = The primary remote changed or was removed; plan the fork action again

dev-baseline-guard-1 = The effective primary fetch URL changed; plan the fork action again

dev-baseline-guard-2 = The contributor's fork remote was removed; plan the action again

dev-baseline-guard-3 = The contributor's fork remote changed; plan the action again

dev-baseline-guard-4 = The primary forge changed; plan this fork action again. Any completed local rewrite remains undoable.

dev-baseline-guard-5 = Unknown saved checkout forge

dev-baseline-guard-6 = This saved fork checkout has no captured destination; check out the pull request again

dev-baseline-guard-7 = The saved fork checkout has no initial effective destination; check out the pull request again

dev-baseline-guard-8 = The saved fork remote is missing; check out the pull request again

dev-baseline-guard-9 = The saved fork destination changed; check out the pull request again

dev-baseline-guard-10 = Missing fork push destination

dev-baseline-guard-11 = Fork push requires an explicit expected commit

dev-baseline-guard-12 = Fork push has no recorded expected commit; plan the action again

dev-baseline-guard-13 = The rebased branch changed before its push; plan the action again

dev-baseline-guard-14 = Missing fork push refspec

dev-baseline-guard-15 = This issue belongs to another primary forge; choose it again

dev-baseline-guard-16 = This issue belongs to another forge repository; open its saved URL to view it

dev-baseline-guard-17 = No primary forge is selected

dev-baseline-guard-18 = The primary forge remote is unavailable; refresh before opening this pull request

dev-baseline-guard-19 = Publication needs the release's push destination

dev-baseline-guard-20 = The primary forge changed during this release; publication stopped. Local changes remain undoable. Close this release before starting one on the new forge.

dev-baseline-guard-21 = The operation on the previous primary forge finished; refresh that repository to check its result

dev-baseline-guard-22 = The push lease must name this exact ref.

dev-baseline-guard-23 = The push lease must name this exact ref and object.

dev-baseline-guard-24 = The push contains contradictory explicit leases; reopen its original action.

dev-baseline-guard-25 = The fetched target differs from the captured push lease; reopen its original action.

dev-baseline-guard-26 = The captured push lease changed; reopen its original action.

dev-baseline-guard-27 = The reviewed fork source changed; reopen push preflight
