  "findings": [
    {
      "id": "OP-NOTICE-1",
      "priority": "P2",
      "title": "Keep unknown operation errors opaque instead of routing them through the push suffix parser",
      "path": "src/repo/notice/operation.rs",
      "start_line": 35,
      "end_line": 36,
      "supporting_paths": [
        {
          "path": "src/push_preflight/display.rs",
          "start_line": 427,
          "end_line": 439
        },
        {
          "path": "locales/de/interaction-guards.ftl",
          "start_line": 252,
          "end_line": 252
        }
      ],
      "trigger": "Any generic op_done failure with no Gerrit witness whose raw message ends in ` Git blob; consider Git LFS.`, for example `provider opaque Git blob; consider Git LFS.`.",
      "source_path": "op_done -> Failure::capture(error,None) -> Failure::projected -> canonical_error -> push_preflight::display::diagnostic -> dynamic",
      "observed_by": "Static source/catalog inspection only; no runtime reproduction.",
      "effect": "At de paint, the unknown body is rewritten to `Git-Blob mit provider opaque; erw\u00e4ge Git LFS.`. Status, finished and retained activity all use this fallback; raw values remain unchanged, but the required opaque presentation boundary is violated.",
      "why_new": "Old generic op_done status interpolated its error unchanged, and the old activity fallback did not invoke the push diagnostic parser. New Failure sources are created for every operation error without any typed push provenance.",
      "requested_change": "Keep fallback diagnostics opaque, or attach and use a finite push-owned presentation captured from the actual producer; do not classify arbitrary generic errors by suffix. Add an inert retained EN-DE-EN lookalike case across status, finished and activity."
    }
  ],
