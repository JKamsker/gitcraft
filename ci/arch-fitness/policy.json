{
  "schema": 1,
  "version": "2026-11-13.1",
  "crates": [
    {
      "name": "gitcraft",
      "root": "src/lib.rs",
      "externs": {
        "gitcraft_os": "gitcraft_os"
      },
      "cfg": {
        "recovery_recording": false
      }
    },
    {
      "name": "gitcraft_bin",
      "root": "src/main.rs",
      "externs": {
        "gitcraft": "gitcraft",
        "gitcraft_os": "gitcraft_os"
      },
      "domain": "app"
    },
    {
      "name": "gitcraft_os",
      "root": "crates/gitcraft-os/src/lib.rs",
      "domain": "os"
    },
    {
      "name": "build",
      "root": "build.rs",
      "test": true,
      "domain": "dev"
    },
    {
      "name": "os_build",
      "root": "crates/gitcraft-os/build.rs",
      "test": true,
      "domain": "dev"
    },
    {
      "name": "test",
      "root": "tests/*.rs",
      "externs": {
        "gitcraft": "gitcraft"
      },
      "test": true,
      "domain": "dev"
    },
    {
      "name": "example",
      "root": "examples/*.rs",
      "externs": {
        "gitcraft": "gitcraft"
      },
      "test": true,
      "domain": "dev"
    },
    {
      "name": "recovery",
      "root": "src/resolver/park/checks/lib.rs",
      "test": true,
      "cfg": {
        "recovery_recording": true
      },
      "domain": "dev"
    },
    {
      "name": "arch_fitness",
      "root": "ci/arch-fitness/src/lib.rs",
      "test": true,
      "domain": "tooling"
    },
    {
      "name": "arch_fitness_bin",
      "root": "ci/arch-fitness/src/main.rs",
      "externs": {
        "gitcraft_arch_fitness": "arch_fitness"
      },
      "test": true,
      "domain": "tooling"
    },
    {
      "name": "arch_fitness_test",
      "root": "ci/arch-fitness/tests/*.rs",
      "externs": {
        "gitcraft_arch_fitness": "arch_fitness"
      },
      "test": true,
      "domain": "tooling"
    }
  ],
  "ignored_files": [
    {
      "path": "src/repo/repository_tools/lifetime_checks.rs",
      "reason": "compiled only by src/repo/repository_tools/pure_checks.py through a #[path] module it writes"
    }
  ],
  "layers": [
    {
      "name": "platform",
      "peers": true,
      "description": "Operating system, processes, workers and file access; no product concepts."
    },
    {
      "name": "presentation",
      "peers": true,
      "description": "Reusable presentation without repository state."
    },
    {
      "name": "services",
      "peers": true,
      "description": "Git, forges, remotes and settings: capabilities features use; no feature UI."
    },
    {
      "name": "features",
      "peers": false,
      "description": "Product features. A feature may not depend on another feature unless an allowed edge says so."
    },
    {
      "name": "coordinator",
      "peers": false,
      "description": "RepoTab: composes feature state and dispatches Actions."
    },
    {
      "name": "shell",
      "peers": true,
      "description": "The application window, entry points and dev harnesses."
    }
  ],
  "domains": {
